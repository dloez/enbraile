{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "buildCommand": "npm run build && npm run db:migrate && if [ \"$VERCEL_ENV\" = preview ]; then SEED_TARGET=preview npm run seed; fi",
  "crons": [{ "path": "/api/cron/sweep-files", "schedule": "0 4 * * *" }],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
