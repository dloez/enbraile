{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dj-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "GUILD_ID": "757377019536211988",
    "DISCORD_APPLICATION_ID": "1563596205026443535",
    "DISCORD_PUBLIC_KEY": "12884510c3dc1f687caee8f9dccb3751bfe4ab1b911e0ad55a434061a9e2d395",
    "WORKER_URL": "https://dj-bot.dloez.workers.dev"
  },
  "containers": [{ "class_name": "Session", "image": "./Dockerfile", "instance_type": "basic", "max_instances": 1 }],
  "durable_objects": { "bindings": [{ "name": "SESSION", "class_name": "Session" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }]
}
