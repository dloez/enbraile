{
  "name": "zombies-site",
  "private": true,
  "type": "module",
  "scripts": {
    "gate": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && tsx scripts/build-api.ts",
    "dev": "vite",
    "dev:api": "tsx --env-file-if-exists=.env.local scripts/dev-api.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "publish": "tsx --env-file-if-exists=.env.local scripts/publish.ts",
    "unpublish": "tsx --env-file-if-exists=.env.local scripts/unpublish.ts",
    "compile": "tsx scripts/compile.ts",
    "runs": "tsx --env-file-if-exists=.env.local scripts/runs.ts",
    "import": "tsx --env-file-if-exists=.env.local scripts/import.ts",
    "watch": "tsx --env-file-if-exists=.env.local scripts/watch.ts",
    "say": "tsx --env-file-if-exists=.env.local scripts/say.ts",
    "replay": "tsx --env-file-if-exists=.env.local scripts/replay.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@hono/node-server": "2.1.5",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
